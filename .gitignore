# build files
app/assets/bundle

# security sensitive
app/.htaccess
app/index.php
app/favicon.ico
app/favicon.png
app/favicon.psd
bundler/localpaths.config.js
dev/apache_conf/*.*

# remove library files
dev/libs

# do not track archived plans
./plan/_archive/*

# per-host local dev config overrides (Kirby config.<host>.php resolution)
# — machine-specific, excluded from deploy.sh, never reaches production
app/site/config/config.localhost.php
app/site/config/config.127.0.0.1.php

# scratch copy of live-server files that conflict with git's version,
# kept for manual diffing/merging — see scripts/deploy.sh
ionos-live-reference/
